# --- Training output (local only; never versioned) ---
# Raw stdout from training runs, per-run evaluation dumps and the derived tables
# built from them. These are regenerated by the scripts under scripts/ from the
# W&B run history; keeping them in the repo bloats every clone.
logs/
results/
callbacks/
artifacts/
checkpoints_local/
transfer_ckpt/
judgement/
isca_logs/
*.ckpt
*.log

# --- Game-selection working data ---
# Regenerated by the selection scripts; the published coordinates live in the
# game-properties table in the paper.
priori/

# --- Weights & Biases ---
wandb/
wandb_export/

# --- Derived analysis tables ---
# Every CSV under analysis_pta/ is written by the scripts in the same directory
# from the W&B export and the SLURM logs. The scripts are the artefact; the
# tables are rebuilt on demand.
analysis_pta/*.csv

# --- Audit / scratch output ---
runs_inventory.csv
scratchpad_*.txt
# Working notes: run audits, sprint plans, cluster references. Local by design.
notes/
# Underscore-prefixed scripts are one-off probes, not part of the pipeline.
scripts/_*.py
# Run manifests are generated by scripts/gen_isca_manifest.py.
experiments/isca_*manifest*.csv
experiments/isca_pilot_*.csv

# --- Run-operations tooling (local only) ---
